<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_viewer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <TextView
                android:id="@+id/viewerCloseButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/btn_close"
                android:clickable="true"
                android:contentDescription="@string/viewer_close"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/failure_color"
                android:textSize="34sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.example.naturalcam.GestureLinearLayout
                android:id="@+id/viewerImageAndFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clickable="true"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/viewerImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/viewerFilterToggle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/btn_look"
                        android:contentDescription="@string/viewer_filter_toggle"
                        android:gravity="center"
                        android:src="@drawable/ic_sparkles"
                        app:tint="@color/btn_selectable" />
                </LinearLayout>
            </com.example.naturalcam.GestureLinearLayout>

            <VideoView
                android:id="@+id/viewerVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/viewerPresetScroll"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="4dp"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="invisible" >

            <LinearLayout
                android:id="@+id/viewerPresetContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">



            <ImageButton
                android:id="@+id/viewerAdjustButton"
                style="@style/ViewerActionButton"
                android:background="@drawable/btn_gallery_mode"
                android:contentDescription="@string/viewer_adjust"
                android:src="@drawable/ic_adjust"
                app:tint="@color/btn_selectable" />

            <ImageButton
                android:id="@+id/viewerSaveButton"
                style="@style/ViewerActionButton"
                android:contentDescription="@string/viewer_save"
                android:src="@drawable/ic_download"
                app:tint="@color/btn_selectable" />

            <ImageButton
                android:id="@+id/viewerShareButton"
                style="@style/ViewerActionButton"
                android:contentDescription="@string/viewer_share"
                android:src="@drawable/ic_share"
                app:tint="@color/btn_selectable" />

            <TextView
                android:id="@+id/viewerLookButton"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_look"
                android:contentDescription="@string/viewer_looks"
                android:gravity="center"
                android:text="✦"
                android:textColor="@color/btn_selectable" />
        </LinearLayout>

        <TextView
            android:id="@+id/viewerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>