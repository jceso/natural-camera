<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mediaCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_connection_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingStart="10dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/startLetters"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="@string/app_start_letters"
        android:textSize="30sp"
        android:textColor="@color/accent_color"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="6dp">

        <TextView
            android:id="@+id/presetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/amber_color"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/presetDesc"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:ellipsize="middle"
            android:maxLines="2"
            android:text="@string/lorem_ipsum"
            android:paddingTop="3dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/editBtn"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/ic_adjust"
        android:gravity="center"
        android:background="@null"
        app:tint="@color/text_secondary" />
</LinearLayout>